# ---- Database (XAMPP MySQL default) ----
# connection_limit keeps the pool small and reused: pages fan out concurrent
# queries (Promise.all in lib/points.ts), and on Windows a burst of fresh TCP
# connects can transiently fail with P1001 "Can't reach database server".
DATABASE_URL="mysql://root@127.0.0.1:3306/cctu_studyhub?connection_limit=10&pool_timeout=20&connect_timeout=10"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ---- Seeded Super Admin ----
SEED_ADMIN_EMAIL="admin@cctu.edu.gh"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ---- Paystack (test mode) ----
# Leave blank to run the built-in sandbox: checkout resolves locally without
# calling Paystack, so the whole purchase/subscription flow is testable offline.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# ---- Email (Resend) ----
# Blank => emails are logged to the server console instead of being sent.
RESEND_API_KEY=""
EMAIL_FROM="CCTU StudyHub <no-reply@cctu.edu.gh>"

# ---- File storage (Cloudflare R2, S3-compatible) ----
# Blank => files are stored on local disk under ./storage and served via /api/files.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# ---- Platform ----
NEXT_PUBLIC_PLATFORM_NAME="CCTU StudyHub"
NEXT_PUBLIC_UNIVERSITY_NAME="Cape Coast Technical University"
NEXT_PUBLIC_CURRENCY="GHS"
SEMESTER_PASS_PRICE="60"
SEMESTER_PASS_DAYS="120"
